# --- Required ---------------------------------------------------------------
# Paste a Figma design link. A frame link (right-click > Copy link to selection)
# exports that frame; a page link exports each top-level frame on the page;
# a link without node-id exports every page of the file.
FIGMA_URL=https://www.figma.com/design/<fileKey>/<File-Name>?node-id=1-2

# --- What to export ----------------------------------------------------------
# frames = the linked node, or all top-level frames of each page
# marked = layers the designer gave export settings (File > Export...)
# images = original raster images (photos, illustrations) used in the design
ASSETS=frames,marked,images

# Formats for "frames": png, jpg, svg, pdf (comma-separated, e.g. png,svg)
FORMATS=png
# Bitmap scale for png/jpg, 0.01 - 4 (Figma's maximum is 4x)
SCALE=2

# auto (default) = selection if the link has a node-id, otherwise file
# selection | page | file
SCOPE=auto
# Extra nodes to export in the same run (SCOPE=selection), e.g. 1234-5678,1234-9012
FIGMA_NODE_IDS=

# --- Browser -----------------------------------------------------------------
OUTPUT_DIR=output
# Leave empty for Playwright's Chromium, or use an installed browser: chrome | msedge
BROWSER_CHANNEL=
# Keep false: you log in in the visible window on the first run, and Figma may
# refuse to load in a headless browser.
HEADLESS=false
# Where the logged-in browser profile is kept between runs
PROFILE_DIR=.figma-profile

# --- Timing (seconds) --------------------------------------------------------
LOGIN_TIMEOUT_SEC=300
EXPORT_TIMEOUT_SEC=300
# Extra wait after the file loads, for very large files raise this
SETTLE_SEC=3
DEBUG=false
